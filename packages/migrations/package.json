{
  "name": "@isthmica/migrations",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "description": "Schema DDL generation, diffing, and a first migrations slice for @isthmica/core table definitions. Optional — @isthmica/core works standalone without this package.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@isthmica/core": "^0.0.1"
  },
  "peerDependencies": {
    "kysely": "^0.29.0"
  },
  "devDependencies": {
    "@isthmica/core": "^0.0.1",
    "@types/better-sqlite3": "^7.6.11",
    "better-sqlite3": "^11.5.0",
    "kysely": "^0.29.5",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
