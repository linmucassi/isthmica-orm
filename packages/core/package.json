{
  "name": "@isthmica/core",
  "version": "0.0.1",
  "description": "Typed, declarative primitives for soft delete, audit, and tenant isolation on top of Kysely.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "kysely": "^0.29.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "kysely": "^0.29.5",
    "pg": "^8.13.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
